#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# MORI Helper v2
#
# Tiny HTB workspace bootstrapper maintained by a judgmental
# Maine Coon.
#
# Usage:
#   mori-helper <machine-name> <ip> [hostname]
#
# Examples:
#   mori-helper Puppy 10.10.11.70
#   mori-helper Puppy 10.10.11.70 puppy.htb
# ============================================================


# ------------------------------------------------------------
# MORI
# ------------------------------------------------------------

mori() {
cat <<'MORI'
              /\_____/\
             /  o   o  \
            ( ==  ^  == )
             )         (
            (           )
           ( (  )   (  ) )
          (__(__)___(__)__)

              M O R I
      target preparation department
MORI
}


# ------------------------------------------------------------
# Usage
# ------------------------------------------------------------

usage() {
    mori

    echo
    echo "MORI stares at you."
    echo
    echo "Usage:"
    echo "  mori-helper <machine-name> <ip> [hostname]"
    echo
    echo "Examples:"
    echo "  mori-helper Puppy 10.10.11.70"
    echo "  mori-helper Puppy 10.10.11.70 puppy.htb"
    echo
    echo '"You forgot the target.'
    echo ' This is generally considered important."'
    echo

    exit 1
}

[[ $# -lt 2 || $# -gt 3 ]] && usage


# ------------------------------------------------------------
# Arguments
# ------------------------------------------------------------

NAME="$1"
TARGET="$2"
HOSTNAME="${3:-}"


# ------------------------------------------------------------
# Validate IPv4-ish input
# ------------------------------------------------------------

if ! [[ "$TARGET" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    echo
    mori
    echo
    echo "MORI does not approve."
    echo
    echo "That does not look like an IPv4 address:"
    echo "  $TARGET"
    echo

    exit 1
fi


# ------------------------------------------------------------
# Create filesystem-safe machine slug
# ------------------------------------------------------------

SLUG="$(
    printf '%s' "$NAME" |
    tr '[:upper:]' '[:lower:]' |
    tr ' ' '-' |
    tr -cd '[:alnum:]._-'
)"

if [[ -z "$SLUG" ]]; then
    echo "[!] Could not generate a valid workspace name."
    exit 1
fi

BASE="$HOME/htb/machines/$SLUG"


# ------------------------------------------------------------
# Protect existing workspace
# ------------------------------------------------------------

if [[ -e "$BASE" ]]; then
    echo
    mori
    echo
    echo "MORI: Absolutely not."
    echo
    echo "That workspace already exists:"
    echo
    echo "  $BASE"
    echo
    echo "\"I'm a cat, not your data-loss prevention strategy.\""
    echo

    exit 1
fi


# ------------------------------------------------------------
# Detect HTB VPN address
# ------------------------------------------------------------

LHOST=""

if ip link show tun0 >/dev/null 2>&1; then
    LHOST="$(
        ip -4 addr show tun0 2>/dev/null |
        awk '/inet / {print $2}' |
        cut -d/ -f1 |
        head -n1
    )"
fi


# ------------------------------------------------------------
# Create workspace
# ------------------------------------------------------------

mkdir -p \
    "$BASE/scans/nmap" \
    "$BASE/scans/web" \
    "$BASE/web" \
    "$BASE/exploits" \
    "$BASE/loot" \
    "$BASE/files" \
    "$BASE/screenshots" \
    "$BASE/scripts"


# ------------------------------------------------------------
# Environment variables
# ------------------------------------------------------------

cat > "$BASE/target.env" <<ENV
export HTB_NAME="$NAME"
export TARGET="$TARGET"
export RHOST="$TARGET"
export LHOST="$LHOST"
export HTB_HOSTNAME="$HOSTNAME"
export HTB_WORKSPACE="$BASE"
ENV


