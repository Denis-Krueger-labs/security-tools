# ------------------------------------------------------------
# Initial Nmap helper
# ------------------------------------------------------------

cat > "$BASE/scan.sh" <<'SCAN'
#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
    pwd
)"

source "$SCRIPT_DIR/target.env"

echo
echo "========================================"
echo " MORI Initial Scan"
echo "========================================"
echo
echo "Machine : $HTB_NAME"
echo "Target  : $TARGET"
echo "LHOST   : ${LHOST:-not detected}"
echo

echo "[*] Running Nmap default scripts + version detection..."

sudo nmap \
    -Pn \
    -sC \
    -sV \
    -oA "$SCRIPT_DIR/scans/nmap/initial" \
    "$TARGET"

echo
echo "[+] Initial scan complete."
echo "[+] Results:"
echo "    $SCRIPT_DIR/scans/nmap/"
echo
SCAN

chmod +x "$BASE/scan.sh"


